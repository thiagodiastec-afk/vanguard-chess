{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "tsx test_all_suites.ts",
    "test:smoke": "tsx test_project_smoke.ts",
    "test:rules": "npx --yes firebase-tools@14.23.0 emulators:exec --only firestore --project demo-vanguard-chess \"node test_firestore_rules.mjs && node test_user_private_migration.mjs\"",
    "test:server": "node test_server_smoke.mjs",
    "migrate:private-users": "node scripts/migrate_user_private.mjs",
    "test:full": "npm test && npm run test:phase513 && npm run test:phase513:residual && tsx test_phase59_backend_equivalence.ts && tsx test_phase510_make_undo.ts && tsx test_phase511_evaluation_equivalence.ts",
    "test:phase513": "tsx test_phase513_zobrist_incremental.ts",
    "test:phase513:residual": "tsx test_phase513_residual_calls.ts",
    "benchmark:phase513": "tsx run_phase513_benchmark.ts",
    "benchmark:quality": "tsx src/lib/analysis/engineBenchmark/runCli.ts",
    "benchmark:legacy": "tsx run_full_validation.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.6.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-chessboard": "^5.1.0",
    "react-dom": "^19.0.1",
    "react-joyride": "^3.2.0",
    "recharts": "^3.10.1",
    "stockfish.js": "^10.0.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
