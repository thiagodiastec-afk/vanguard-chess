# Server-side API key; never prefix secrets with VITE_.
GEMINI_API_KEY=

# Optional override for the public reCAPTCHA Enterprise site key in firebase-applet-config.json.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Firebase Admin service account JSON, kept in the deployment secret manager.
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_DATABASE_ID=ai-studio-fcb48dec-7903-4132-9310-02b17375279b

# Mercado Pago credentials from the same app/environment (test or production).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Comma-separated verified Firebase Auth email addresses allowed to issue VIP invite codes.
VIP_INVITE_ADMIN_EMAILS=

# Public HTTPS origin used for payment redirects and notifications.
APP_URL=

# Optional HTTP port; the server defaults to 3000.
PORT=3000
