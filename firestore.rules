rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function canStartGame() {
      let privatePath = /databases/$(database)/documents/userPrivate/$(request.auth.uid);
      return !exists(privatePath)
        || !('playSuspendedUntil' in get(privatePath).data)
        || get(privatePath).data.playSuspendedUntil <= request.time.toMillis();
    }
    function changedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Users
    match /users/{userId} {
      // Version 2 profiles contain no wallet or subscription fields. Requiring
      // the marker also prevents queries from returning unmigrated legacy docs.
      allow read: if isOwner(userId) || resource.data.profileSchemaVersion == 2;
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().profileSchemaVersion == 2
        && incoming().keys().hasOnly([
          'uid', 'profileSchemaVersion', 'displayName', 'hasSetNickname', 'elo', 'gamesPlayed', 'activeBackground', 'activeTheme',
          'isOnline', 'lastSeen', 'friends'
        ])
        && incoming().elo in [1000, 1200]
        && incoming().gamesPlayed == 0
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 40));
      // Wallet and paid entitlements are server-owned. Clients cannot grant
      // themselves coins, premium status, or premium time.
      allow update: if isOwner(userId)
        && changedUserFields().hasOnly([
          'displayName', 'hasSetNickname', 'isOnline', 'lastSeen',
          'activeTheme', 'activeBackground', 'friends'
        ])
        && (!changedUserFields().hasAny(['displayName']) ||
            (incoming().displayName is string && incoming().displayName.size() <= 40));
      allow delete: if false;
    }

    // Wallet, cosmetic inventory, and subscription state are private to their owner.
    // All changes after the one-time starter grant are server-side only.
    match /userPrivate/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && incoming().keys().hasOnly(['coins', 'unlockedThemes', 'unlockedBackgrounds', 'isPremium', 'premiumUntil'])
        && incoming().coins == 500
        && incoming().unlockedThemes == ['luxury', 'classic']
        && incoming().unlockedBackgrounds == ['default']
        && incoming().isPremium == false
        && incoming().premiumUntil == 0;
      allow update, delete: if false;
    }

    // Queue
    match /queue/{queueId} {
      allow read: if isSignedIn();
      allow create: if isOwner(queueId)
        && canStartGame()
        && incoming().uid == request.auth.uid
        && incoming().keys().hasOnly(['uid', 'displayName', 'elo', 'createdAt', 'timeControl', 'activeTheme']);
      allow update: if isOwner(queueId)
        && canStartGame()
        && incoming().uid == request.auth.uid
        && incoming().keys().hasOnly(['uid', 'displayName', 'elo', 'createdAt', 'timeControl', 'activeTheme']);
      allow delete: if isOwner(queueId);
    }

    // Games
    match /games/{gameId} {
      allow read: if (existing().status == 'playing'
          && existing().spectatorsAllowedWhite == true
          && existing().spectatorsAllowedBlack == true)
        || (isSignedIn()
          && (existing().whiteId == request.auth.uid || existing().blackId == request.auth.uid));
      // Game state is created and mutated only by authenticated Admin SDK routes.
      allow create, update, delete: if false;
    }

    // Global Chat (read-only for clients, server writes)
    match /globalChat/{messageId} {
      allow read: if true;
      allow write: if false;
    }

    // Challenges (Direct Invites)
    match /challenges/{challengeId} {
      allow read: if isSignedIn()
        && (resource.data.challengerId == request.auth.uid || resource.data.challengedId == request.auth.uid);
      // Challenge identity fields are populated from trusted profiles by the server.
      allow create: if false;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (existing().challengedId == request.auth.uid
            && existing().status == 'pending'
            && request.resource.data.status == 'declined')
          ||
          (existing().challengerId == request.auth.uid
            && existing().status == 'accepted'
            && request.resource.data.status == 'completed')
        );
      allow delete: if isSignedIn()
        && (existing().challengerId == request.auth.uid || existing().challengedId == request.auth.uid);
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      // Official events and prizes are provisioned by the Admin SDK only.
      allow create: if false;
      allow update: if isSignedIn()
        && canStartGame()
        && existing().managedByServer == true
        && existing().status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == resource.data.participants.size() + 1
        && request.resource.data.participants.hasAll(resource.data.participants)
        && !existing().participants.hasAny([request.auth.uid])
        && request.resource.data.participants[resource.data.participants.size()] == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileSchemaVersion == 2
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.elo >= existing().minElo
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.elo <= existing().maxElo;
      allow delete: if false;
    }
    // Reports (Anti-Cheat)
    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow read: if false; // Only admins/backend can read
    }

    // Room Chats (Game Chat)
    match /messages/{messageId} {
      allow read: if true;
      allow create: if false; // Server validates membership, rate limits, and message size.
      allow update, delete: if false;
    }
  }
}
